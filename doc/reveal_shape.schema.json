{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theme Reveal Kit vector shape document",
  "description": "Structural schema only; runtime enforces 1 MiB input, finite geometry, SVG syntax and non-empty filled area.",
  "oneOf": [
    {
      "$ref": "#/$defs/pathDocument"
    },
    {
      "$ref": "#/$defs/shapeDocument"
    }
  ],
  "$defs": {
    "viewBox": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        },
        {
          "type": "null"
        }
      ]
    },
    "transform": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        {
          "type": "null"
        }
      ]
    },
    "pathDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "paths"
      ],
      "properties": {
        "type": {
          "const": "path"
        },
        "viewBox": {
          "$ref": "#/$defs/viewBox"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "d"
            ],
            "properties": {
              "d": {
                "type": "string",
                "pattern": "\\S"
              },
              "fillRule": {
                "enum": [
                  "nonZero",
                  "evenOdd",
                  null
                ]
              },
              "transform": {
                "$ref": "#/$defs/transform"
              }
            }
          }
        }
      }
    },
    "shapeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "shape"
      ],
      "properties": {
        "type": {
          "const": "shape"
        },
        "shape": {
          "enum": [
            "circle",
            "triangle",
            "heart",
            "diamond",
            "hexagon",
            "ellipse",
            "rectangle",
            "roundedRectangle",
            "star",
            "polygon"
          ]
        },
        "viewBox": {
          "$ref": "#/$defs/viewBox"
        },
        "parameters": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "circle"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "triangle"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "heart"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "diamond"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "hexagon"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "ellipse"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "aspectRatio": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "rectangle"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "aspectRatio": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "roundedRectangle"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "aspectRatio": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cornerRadius": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "star"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "points": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 512
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "innerRadius": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "exclusiveMaximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "polygon"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "sides": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 512
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
